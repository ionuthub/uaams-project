rules_version = '2';

// UAAMS Firestore security rules: first Sprint 2 pass by Dawid and Ionut.
// Enforces the two core guarantees of the demo path:
//   1. Students only ever see their own applications.
//   2. Admins only see applications for THEIR university (scoping).
// Field-level allow-lists on user/application updates added after PR review.
// Sprint 3 TODO: App Check, GDPR delete cascade (IS-06).
// Value limits added (#190): every string a client can write is now bounded,
// and text a human will read (decision messages, notes, names) must actually
// say something - see capped(), fieldCapped() and meaningfulText() below.
// Still outstanding: pattern validation (a name is length-checked here, not
// checked for shape), and App Check.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isVerified() && userDoc().role == 'admin';
    }
    // ---- value limits (#190) ----
    // The apply form caps every free-text field, but the form runs in the
    // browser and can be bypassed, so the same caps live here. Without these
    // the rules only checked that a field EXISTS, not what is in it - which is
    // why a 100,000 character name could be written directly to Firestore.
    //
    // Reads through get() with an empty default so an absent optional field is
    // simply within its limit rather than an error, and non-string values are
    // left alone for the field-specific rules to handle.
    function capped(form, field, max) {
      return !(form.get(field, '') is string) || form.get(field, '').size() <= max;
    }

    // For a single top-level string field rather than one inside the form map.
    // Absent is allowed here; callers add their own presence checks where a
    // field is mandatory.
    function fieldCapped(data, field, max) {
      return !(data.get(field, '') is string) || data.get(field, '').size() <= max;
    }

    // A message a human wrote and another human will read. Must actually say
    // something (Silvana's finding: a blank decision message was accepted) and
    // must not be unbounded.
    function meaningfulText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function formWithinLimits(form) {
      return capped(form, 'fullName', 100)
             && capped(form, 'nationality', 60)
             && capped(form, 'passportNumber', 20)
             && capped(form, 'phone', 20)
             && capped(form, 'address', 250)
             && capped(form, 'previousQualification', 120)
             && capped(form, 'institutionName', 120)
             && capped(form, 'graduationYear', 4)
             && capped(form, 'gpa', 20)
             && capped(form, 'courseName', 120)
             && capped(form, 'intake', 40)
             && capped(form, 'personalStatement', 4000);
    }

    function adminOf(universityId) {
      return isAdmin() && userDoc().universityId == universityId;
    }

    // ---- users ----
    match /users/{uid} {
      // A user reads/creates their own profile. Role is fixed to "student"
      // on self-creation - admin accounts are made only by the seed script.
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'student'
                    && request.resource.data.privacyConsent == true
                    && meaningfulText(request.resource.data.fullName, 100)
                    && fieldCapped(request.resource.data, 'nationality', 60)
                    && fieldCapped(request.resource.data, 'studyLevel', 40)
                    && fieldCapped(request.resource.data, 'email', 254)
                    && request.resource.data.keys()
                         .hasOnly(['email', 'fullName', 'role', 'nationality', 'studyLevel', 'privacyConsent', 'privacyConsentAt', 'createdAt', 'updatedAt'])
                    && request.resource.data.keys()
                         .hasAll(['email', 'fullName', 'role', 'nationality', 'studyLevel', 'privacyConsent', 'privacyConsentAt', 'createdAt']);
      allow update: if signedIn()
              && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['fullName', 'updatedAt'])
              && meaningfulText(request.resource.data.fullName, 100);
      allow delete: if false; // GDPR delete cascade is a Sprint 3 item (IS-06)
    }

    // ---- universities (read-only reference data) ----
    match /universities/{id} {
      allow read: if signedIn();
      allow write: if false; // seeded via Admin SDK only
    }

    // ---- applications ----
    match /applications/{appId} {
      // Student: own applications. Admin: applications for their university.
      allow read: if isVerified()
                  && (resource.data.studentUid == request.auth.uid
                      || adminOf(resource.data.universityId));

      // Only a verified student can create, and only as themselves, in draft.
      allow create: if isVerified()
                    && request.resource.data.studentUid == request.auth.uid
                    && request.resource.data.status == 'draft'
                    && formWithinLimits(request.resource.data.form)
                    && request.resource.data.keys()
                         .hasOnly(['studentUid', 'universityId', 'status', 'form', 'documentPath', 'documents', 'createdAt', 'updatedAt'])
                    && request.resource.data.keys()
                         .hasAll(['studentUid', 'universityId', 'status', 'form', 'createdAt', 'updatedAt']);

      // Student: may edit allowed draft fields only, and may move
      // status draft -> submitted. Admin: may write decision fields only.
      allow update: if isVerified() && (
        // ---- #194: student withdraws a submitted application ----
        // This is the ONLY case where a student may change an application
        // after submission, so it is deliberately narrow:
        //   - only the owning student
        //   - only FROM submitted or under_review (a draft was never
        //     submitted; a decided application is never rewritten)
        //   - only TO withdrawn, never to any other status
        //   - only the status/withdrawnAt/updatedAt fields
        // 'withdrawn' is absent from the from-list on purpose: once set there
        // is no route back out of it, so a withdrawal cannot be undone by the
        // student or turned into an offer.
        (
          resource.data.studentUid == request.auth.uid
          && resource.data.status in ['submitted', 'under_review']
          && request.resource.data.status == 'withdrawn'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'withdrawnAt', 'updatedAt'])
        )
        ||
        (
          resource.data.studentUid == request.auth.uid
          && resource.data.status == 'draft'
          && formWithinLimits(request.resource.data.form)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['form', 'documentPath', 'documents', 'status', 'submittedAt', 'updatedAt'])
          && (request.resource.data.status == 'draft'
              || (request.resource.data.status == 'submitted'
                  // PRD 4.2.3 (issue #152): the three mandatory document
                  // types must be attached before submission. English test
                  // stays optional. documentPath remains for back-compat.
                  && request.resource.data.documents.passportCopy.path is string
                  && request.resource.data.documents.transcripts.path is string
                  && request.resource.data.documents.certificates.path is string))
        )
        ||
        (
          adminOf(resource.data.universityId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'latestDecisionMessage', 'updatedAt'])
          && request.resource.data.status in ['under_review', 'offer', 'rejected']
          // A decision message is optional when simply moving to under review,
          // but if one is written it must be real text and bounded. The blank
          // case is caught in the decisions subcollection below, where the
          // message is mandatory.
          && fieldCapped(request.resource.data, 'latestDecisionMessage', 2000)
        )
      );

      allow delete: if false; // no deletes in the PoC; GDPR cascade is Sprint 3

      // ---- decision audit log (IS-05): append-only ----
      match /decisions/{decisionId} {
        allow read: if isVerified()
                    && (get(/databases/$(database)/documents/applications/$(appId)).data.studentUid == request.auth.uid
                        || adminOf(get(/databases/$(database)/documents/applications/$(appId)).data.universityId));
        allow create: if adminOf(get(/databases/$(database)/documents/applications/$(appId)).data.universityId)
                      && request.resource.data.decidedBy == request.auth.uid
                      && request.resource.data.decision in ['offer', 'rejected']
                      // Silvana's finding: a blank decision message was accepted
                      // and written to an append-only log that can never be
                      // corrected, only superseded.
                      && meaningfulText(request.resource.data.message, 2000)
                      && request.resource.data.keys()
                           .hasOnly(['decision', 'message', 'decidedBy', 'decidedAt'])
                      && request.resource.data.keys()
                           .hasAll(['decision', 'message', 'decidedBy', 'decidedAt']);
        allow update, delete: if false; // decisions are never edited or removed
      }

      // ---- internal admin notes (PRD 4.3.2) ----
      // Scoped admins of the owning university only. Students can never read
      // these, which is the whole point of an internal note. Append-only for
      // the same reason as decisions: a note is a record of what was thought
      // at the time, so it is never edited or deleted.
      match /notes/{noteId} {
        allow read: if adminOf(get(/databases/$(database)/documents/applications/$(appId)).data.universityId);
        allow create: if adminOf(get(/databases/$(database)/documents/applications/$(appId)).data.universityId)
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.universityId == get(/databases/$(database)/documents/applications/$(appId)).data.universityId
                      && request.resource.data.keys()
                           .hasOnly(['body', 'authorUid', 'authorName', 'universityId', 'createdAt'])
                      && meaningfulText(request.resource.data.body, 2000);
        allow update, delete: if false;
      }
    }

    // ---- in-app notifications (PRD 4.2.2, issue #164) ----
    // Created only by the server routes (Admin SDK bypasses rules). A student
    // reads their own notifications and may only flip readStatus to true.
    match /notifications/{noticeId} {
      allow read: if isVerified() && resource.data.userId == request.auth.uid;
      allow update: if isVerified()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['readStatus'])
                    && request.resource.data.readStatus == true;
      allow create, delete: if false;
    }

    // ---- email logs (written only by the protected server route) ----
    match /emailLogs/{logId} {
      allow read: if isAdmin()
                  && resource.data.universityId == userDoc().universityId;
      allow write: if false; // Firebase Admin performs authorised server writes
    }
  }
}
