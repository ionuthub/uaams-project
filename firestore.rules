rules_version = '2';

// UAAMS Firestore security rules: first Sprint 2 pass by Dawid and Ionut.
// Enforces the two core guarantees of the demo path:
//   1. Students only ever see their own applications.
//   2. Admins only see applications for THEIR university (scoping).
// Field-level allow-lists on user/application updates added after PR review.
// Sprint 3 TODO: value-format validation, App Check, GDPR delete cascade (IS-06).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isVerified() && userDoc().role == 'admin';
    }
    function adminOf(universityId) {
      return isAdmin() && userDoc().universityId == universityId;
    }

    // ---- users ----
    match /users/{uid} {
      // A user reads/creates their own profile. Role is fixed to "student"
      // on self-creation - admin accounts are made only by the seed script.
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'student'
                    && request.resource.data.privacyConsent == true
                    && request.resource.data.keys()
                         .hasOnly(['email', 'fullName', 'role', 'nationality', 'studyLevel', 'privacyConsent', 'privacyConsentAt', 'createdAt', 'updatedAt'])
                    && request.resource.data.keys()
                         .hasAll(['email', 'fullName', 'role', 'nationality', 'studyLevel', 'privacyConsent', 'privacyConsentAt', 'createdAt']);
      allow update: if signedIn()
              && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['fullName', 'updatedAt']);
      allow delete: if false; // GDPR delete cascade is a Sprint 3 item (IS-06)
    }

    // ---- universities (read-only reference data) ----
    match /universities/{id} {
      allow read: if signedIn();
      allow write: if false; // seeded via Admin SDK only
    }

    // ---- applications ----
    match /applications/{appId} {
      // Student: own applications. Admin: applications for their university.
      allow read: if isVerified()
                  && (resource.data.studentUid == request.auth.uid
                      || adminOf(resource.data.universityId));

      // Only a verified student can create, and only as themselves, in draft.
      allow create: if isVerified()
                    && request.resource.data.studentUid == request.auth.uid
                    && request.resource.data.status == 'draft'
                    && request.resource.data.keys()
                         .hasOnly(['studentUid', 'universityId', 'status', 'form', 'documentPath', 'documents', 'createdAt', 'updatedAt'])
                    && request.resource.data.keys()
                         .hasAll(['studentUid', 'universityId', 'status', 'form', 'createdAt', 'updatedAt']);

      // Student: may edit allowed draft fields only, and may move
      // status draft -> submitted. Admin: may write decision fields only.
      allow update: if isVerified() && (
        (
          resource.data.studentUid == request.auth.uid
          && resource.data.status == 'draft'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['form', 'documentPath', 'documents', 'status', 'submittedAt', 'updatedAt'])
          && (request.resource.data.status == 'draft'
              || (request.resource.data.status == 'submitted'
                  // PRD 4.2.3 (issue #152): the three mandatory document
                  // types must be attached before submission. English test
                  // stays optional. documentPath remains for back-compat.
                  && request.resource.data.documents.passportCopy.path is string
                  && request.resource.data.documents.transcripts.path is string
                  && request.resource.data.documents.certificates.path is string))
        )
        ||
        (
          adminOf(resource.data.universityId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'latestDecisionMessage', 'updatedAt'])
          && request.resource.data.status in ['under_review', 'offer', 'rejected']
        )
      );

      allow delete: if false; // no deletes in the PoC; GDPR cascade is Sprint 3

      // ---- decision audit log (IS-05): append-only ----
      match /decisions/{decisionId} {
        allow read: if isVerified()
                    && (get(/databases/$(database)/documents/applications/$(appId)).data.studentUid == request.auth.uid
                        || adminOf(get(/databases/$(database)/documents/applications/$(appId)).data.universityId));
        allow create: if adminOf(get(/databases/$(database)/documents/applications/$(appId)).data.universityId)
                      && request.resource.data.decidedBy == request.auth.uid
                      && request.resource.data.decision in ['offer', 'rejected']
                      && request.resource.data.keys()
                           .hasOnly(['decision', 'message', 'decidedBy', 'decidedAt'])
                      && request.resource.data.keys()
                           .hasAll(['decision', 'message', 'decidedBy', 'decidedAt']);
        allow update, delete: if false; // decisions are never edited or removed
      }

      // ---- internal admin notes (PRD 4.3.2) ----
      // Scoped admins of the owning university only. Students can never read
      // these, which is the whole point of an internal note. Append-only for
      // the same reason as decisions: a note is a record of what was thought
      // at the time, so it is never edited or deleted.
      match /notes/{noteId} {
        allow read: if adminOf(get(/databases/$(database)/documents/applications/$(appId)).data.universityId);
        allow create: if adminOf(get(/databases/$(database)/documents/applications/$(appId)).data.universityId)
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.universityId == get(/databases/$(database)/documents/applications/$(appId)).data.universityId
                      && request.resource.data.keys()
                           .hasOnly(['body', 'authorUid', 'authorName', 'universityId', 'createdAt'])
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0;
        allow update, delete: if false;
      }
    }

    // ---- in-app notifications (PRD 4.2.2, issue #164) ----
    // Created only by the server routes (Admin SDK bypasses rules). A student
    // reads their own notifications and may only flip readStatus to true.
    match /notifications/{noticeId} {
      allow read: if isVerified() && resource.data.userId == request.auth.uid;
      allow update: if isVerified()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['readStatus'])
                    && request.resource.data.readStatus == true;
      allow create, delete: if false;
    }

    // ---- email logs (written only by the protected server route) ----
    match /emailLogs/{logId} {
      allow read: if isAdmin()
                  && resource.data.universityId == userDoc().universityId;
      allow write: if false; // Firebase Admin performs authorised server writes
    }
  }
}
